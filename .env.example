# Public site details
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_BUSINESS_NAME=Gazette Legal Services
NEXT_PUBLIC_PHONE=+919999999999
NEXT_PUBLIC_WHATSAPP=919999999999
NEXT_PUBLIC_EMAIL=hello@example.com

# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin login. Generate the hash with: npm run hash-password -- your-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=\$2b\$12\$replace_with_the_generated_bcrypt_hash
AUTH_SECRET=replace-with-at-least-32-random-characters

# New enquiry email notifications (Resend)
RESEND_API_KEY=re_replace_with_your_api_key
LEAD_NOTIFICATION_EMAIL=advocate@example.com
RESEND_FROM_EMAIL=Gazette Website <enquiries@yourdomain.com>

# Cloudflare Turnstile (optional in local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private S3-compatible object storage (Cloudflare R2 recommended)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gazette-private-documents
R2_PUBLIC_BUCKET=gazette-public-images
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary public website and blog images (free plan supported)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
